@model User
@{
    ViewData["Title"] = "My Profile";
    var initials = "U";
    if (!string.IsNullOrWhiteSpace(Model.FullName))
    {
        var parts = Model.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length > 0)
        {
            initials = string.Join("", parts.Select(n => n[0])).ToUpper();
        }
    }
    if (initials.Length > 2) initials = initials.Substring(0, 2);
}

@section Styles {
    <link rel="stylesheet" href="~/css/settings/settings.css" asp-append-version="true" />
}

<div class="settings-page-container">
    <div class="page-title-section">
        <h2>My Front Desk Profile</h2>
        <p>Manage your contact details, personal full name representation, and registration coordinates.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" style="margin-bottom: 20px; padding: 12px; border-radius: 4px; background-color: #d4edda; border: 1px solid #c3e6cb; color: #155724;">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" style="margin-bottom: 20px; padding: 12px; border-radius: 4px; background-color: #f8d7da; border: 1px solid #f5c6cb; color: #721c24;">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="settings-layout">
        <!-- LEFT COLUMN: AVATAR / SUMMARY PANEL -->
        <aside class="settings-sidebar" style="padding: 20px; background: white; border: 1px solid var(--border); border-radius: var(--radius-lg);">
            <div style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 15px;">
                <div class="pc-avatar" style="width: 80px; height: 80px; font-size: 24px; margin: 0 auto; display: flex; align-items: center; justify-content: center; background-color: #f0f4f8; color: var(--primary); font-weight: bold; border-radius: 50%;">
                    @initials
                </div>
                <div>
                    <h3 style="font-size: 18px; font-weight: 700; margin-bottom: 4px; color: var(--text-dark);">@Model.FullName</h3>
                    <span class="badge badge-success" style="font-size: 12px; padding: 4px 8px; border-radius: 4px; text-transform: uppercase;">@Model.Role</span>
                </div>
                <hr style="width: 100%; border: 0; border-top: 1px solid var(--border); margin: 10px 0;" />
                <div style="font-size: 13px; color: var(--text-muted); width: 100%; text-align: left;">
                    <div style="margin-bottom: 8px;"><strong>Username:</strong> <span style="font-family: monospace;">@Model.Username</span></div>
                    <div style="margin-bottom: 8px;"><strong>Role Access:</strong> Front Desk Desk Operative</div>
                </div>
            </div>
        </aside>

        <!-- RIGHT COLUMN: PROFILE FORM PANEL -->
        <main class="settings-content-panel" style="background: white; border: 1px solid var(--border); border-radius: var(--radius-lg);">
            <div class="settings-tab-content active" id="profile-tab">
                <div class="card-header" style="padding: 20px; border-bottom: 1px solid var(--border);">
                    <h4 style="font-size: 16px; font-weight: 700; color: var(--text-dark);">Edit Personal Profile Credentials</h4>
                    <p style="font-size: 13px; color: var(--text-muted); margin-top: 4px;">Update details that are displayed on shift logs and admin panels.</p>
                </div>
                <form asp-action="UpdateProfile" asp-controller="Receptionist" method="post">
                    <div class="card-body" style="padding: 20px; display: flex; flex-direction: column; gap: 20px;">
                        
                        <div class="form-group">
                            <label style="display: block; margin-bottom: 6px; font-weight: 600; font-size: 13px;">Full Name</label>
                            <input type="text" name="fullName" value="@Model.FullName" placeholder="e.g. Sita Ramam" required style="width: 100%; padding: 10px; border: 1px solid var(--border); border-radius: var(--radius-md); font-size: 14px;" />
                        </div>

                        <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                            <div class="form-group">
                                <label style="display: block; margin-bottom: 6px; font-weight: 600; font-size: 13px;">Contact Phone</label>
                                <input type="tel" name="contactNumber" value="@Model.ContactNumber" placeholder="e.g. 9876543210" style="width: 100%; padding: 10px; border: 1px solid var(--border); border-radius: var(--radius-md); font-size: 14px;" />
                            </div>
                            <div class="form-group">
                                <label style="display: block; margin-bottom: 6px; font-weight: 600; font-size: 13px;">Email Address</label>
                                <input type="email" name="email" value="@Model.Email" placeholder="e.g. receptionist@cogmedi.com" style="width: 100%; padding: 10px; border: 1px solid var(--border); border-radius: var(--radius-md); font-size: 14px;" />
                            </div>
                        </div>

                    </div>
                    
                    <div class="card-footer" style="padding: 16px 20px; border-top: 1px solid var(--border); background-color: #fcfdfe; display: flex; justify-content: flex-end; border-bottom-left-radius: var(--radius-lg); border-bottom-right-radius: var(--radius-lg);">
                        <button type="submit" class="btn btn-primary"><i data-lucide="save"></i> Update Profile Credentials</button>
                    </div>
                </form>
            </div>
        </main>
    </div>
</div>
