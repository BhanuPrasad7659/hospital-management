        </div>
    </section>

    <!-- Bottom CTA Banner Section -->
    <section class="bottom-cta-banner">
        <div class="bcb-container">
            <h2>Empowering Smarter Healthcare, Today</h2>
            <p>Integrate your hospital operations with the CogMedi ecosystem. Flawless patient tracking, quick billing, and unified EHR charts await your clinical team.</p>
            <a href="#portals" class="btn btn-primary btn-lg bcb-btn">
                Launch Employee Portals <i data-lucide="arrow-right"></i>
            </a>
        </div>
    </section>

    <!-- Public Footer -->
    <footer class="public-footer">
        <div class="pf-container">
            <div class="pf-brand">
                <div class="pf-logo">
                    <i data-lucide="activity"></i>
                    <h3>CogMedi Hospital</h3>
                </div>
                <p>Digital Healthcare Management Made Easy. Empowering physicians, coordinating clinical departments, and caring for patients with state-of-the-art software systems.</p>
            </div>
            <div class="pf-links">
                <h4>Quick Links</h4>
                <a href="#portals">Employee Portals</a>
