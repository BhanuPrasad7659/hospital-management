@{
    ViewData["Title"] = "Patient Clinical History & Diagnostic Logs";
    var patient = ViewBag.Patient as CogMediHospitalManagementSystem.Models.Patient;
    var treatments = ViewBag.Treatments as List<CogMediHospitalManagementSystem.Models.TreatmentPlan> ?? new List<CogMediHospitalManagementSystem.Models.TreatmentPlan>();
    var labOrders = ViewBag.LabOrders as List<CogMediHospitalManagementSystem.Models.LabOrder> ?? new List<CogMediHospitalManagementSystem.Models.LabOrder>();
}

<div class="container" style="padding: 24px; max-width: 1200px; margin: 0 auto;">
    <div class="header-card" style="background: #fff; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0; margin-bottom: 24px;">
        <h2><i data-lucide="file-text"></i> Patient Comprehensive Log</h2>
        @if (patient != null)
        {
            <p style="margin: 5px 0 0 0; color: #475569;">
                <strong>Name:</strong> @patient.Name |
                <strong>Patient ID:</strong> #@patient.PatientId |
                <strong>Age:</strong> @patient.Age |
                <strong>Status:</strong> <span class="badge">@patient.Status</span>
            </p>
        }
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">

        <!-- LEFT COLUMN: TREATMENT LOGS -->
        <div style="background: #fff; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0;">
            <h3 style="border-bottom: 2px solid #2563eb; padding-bottom: 8px; margin-top: 0;">
                <i data-lucide="stethoscope"></i> Treatment & Care Logs
            </h3>

            @if (treatments.Any())
            {
                @foreach (var tx in treatments)
                {
                    <div style="background: #f8fafc; border-left: 4px solid #2563eb; padding: 12px; border-radius: 4px; margin-bottom: 12px;">
                        <div style="display: flex; justify-content: space-between; font-size: 0.85rem; color: #64748b;">
                            <span>@tx.PrescribedDate.ToString("dd MMM yyyy, hh:mm tt")</span>
                            <span>Dr. @tx.DoctorName</span>
                        </div>
                        <h4 style="margin: 8px 0 4px 0; color: #1e293b;">Condition: @tx.Diagnosis</h4>
                        <p style="margin: 0 0 8px 0; color: #334155;"><strong>Care Course:</strong> @tx.TreatmentDescription</p>

                        @if (!string.IsNullOrEmpty(tx.Medication))
                        {
                            <div style="background: #fff; padding: 8px; border-radius: 4px; border: 1px solid #e2e8f0;">
                                <strong style="font-size: 0.85rem; color: #059669;">Prescribed Rx:</strong>
                                <span style="font-size: 0.9rem;">@tx.Medication</span>
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <p class="text-muted">No treatment records logged for this patient.</p>
            }
        </div>

        <!-- RIGHT COLUMN: LAB RESULTS -->
        <div style="background: #fff; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0;">
            <h3 style="border-bottom: 2px solid #059669; padding-bottom: 8px; margin-top: 0;">
                <i data-lucide="flask-conical"></i> Diagnostic Lab Findings
            </h3>

            @if (labOrders.Any())
            {
                @foreach (var lab in labOrders)
                {
                    var isCompleted = lab.Status == "COMPLETED";
                    <div style="background: #f8fafc; border-left: 4px solid @(isCompleted ? "#059669" : "#d97706"); padding: 12px; border-radius: 4px; margin-bottom: 12px;">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <strong style="color: #1e293b;">@lab.TestName</strong>
                            <span style="font-size: 0.75rem; font-weight: bold; padding: 2px 8px; border-radius: 12px; background: @(isCompleted ? "#d1fae5" : "#fef3c7"); color: @(isCompleted ? "#065f46" : "#92400e");">
                                @lab.Status
                            </span>
                        </div>
                        <small style="color: #64748b; display: block; margin: 4px 0 8px 0;">
                            Ordered: @lab.OrderDate.ToString("dd MMM yyyy") | Tech: @(string.IsNullOrEmpty(lab.TechnicianName) ? "Pending" : lab.TechnicianName)
                        </small>

                        @if (isCompleted)
                        {
                            <div style="background: #fff; padding: 10px; border-radius: 4px; border: 1px solid #cbd5e1; font-family: monospace; font-size: 0.9rem;">
                                <strong>Findings:</strong> @lab.Result
                            </div>
                        }
                        else
                        {
                            <p style="font-style: italic; color: #64748b; margin: 0;">Test specimen processing in progress...</p>
                        }
                    </div>
                }
            }
            else
            {
                <p class="text-muted">No lab orders found for this patient.</p>
            }
        </div>

    </div>
</div>