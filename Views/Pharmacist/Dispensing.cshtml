@model List<PharmacyRecord>
@{
    ViewData["Title"] = "Pharmacy Drug Dispensing Portal";
    var patients = ViewBag.Patients as List<Patient> ?? new List<Patient>();
    var stock = ViewBag.MedicineStock as Dictionary<string, int> ?? new Dictionary<string, int>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/pharmacist/dispensing.css" asp-append-version="true" />
}

<div class="dispensing-container">
    <div class="page-title-section">
        <h2>Pharmacy Drug Dispensing Portal</h2>
        <p>Inspect physician prescriptions, dispense drugs, and manage medicine inventory levels.</p>
    </div>

    <div class="dispensing-grid">
        <!-- LEFT PANEL: DISPENSING QUEUE -->
        <div class="queue-panel">
            <div class="table-card">
                <div class="card-header">
                    <i data-lucide="clipboard-list" class="card-icon text-primary"></i>
                    <h4>Prescription Dispensing Queue</h4>
                    <span class="badge badge-primary">@Model.Count Total Orders</span>
                </div>
                <div class="card-body">
                    @if (Model.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Ref ID</th>
                                        <th>Patient Name</th>
                                        <th>Medicine Name</th>
                                        <th>Quantity</th>
                                        <th>Status</th>
                                        <th>Dispensing Details</th>
                                        <th class="text-right">Dispense Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var record in Model)
                                    {
                                        var pat = patients.FirstOrDefault(p => p.PatientId == record.PatientId);
                                        <tr>
                                            <td><strong>#@record.PharmacyRecordId</strong></td>
                                            <td>
                                                <div class="pat-name">@(pat?.Name ?? "Patient")</div>
                                                <div class="pat-id">ID: #@record.PatientId</div>
                                            </td>
                                            <td>
                                                <span class="med-name-tag"><i data-lucide="pill" class="icon-tiny"></i> @record.MedicineName</span>
                                            </td>
                                            <td><strong>@record.Quantity</strong> units</td>
                                            <td>
                                                <span class="badge @(record.Status == "DISPENSED" ? "badge-success" : "badge-warning")">
                                                    @record.Status
                                                </span>
                                            </td>
                                            <td>
                                                @if (record.Status == "DISPENSED")
                                                {
                                                    <div class="dispensed-meta">
                                                        <span>Date: @record.DispensedDate?.ToString("dd-MM-yyyy")</span>
                                                        <span>By: @record.PharmacistName</span>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted-italic">Awaiting dispensing</span>
                                                }
                                            </td>
                                            <td class="text-right">
                                                @if (record.Status == "PENDING")
                                                {
                                                    <form asp-action="Dispense" asp-controller="Pharmacist" method="post" class="inline-form">
                                                        <input type="hidden" name="recordId" value="@record.PharmacyRecordId" />
                                                        <button type="submit" class="btn btn-primary btn-xs">
                                                            <i data-lucide="check" class="icon-tiny"></i> Dispense Now
                                                        </button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <span class="text-success-bold"><i data-lucide="check-circle" class="icon-tiny"></i> Handed Over</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i data-lucide="pill-bottle" class="empty-icon"></i>
                            <p>No active prescriptions awaiting dispensing.</p>
                            <span class="subtext">Physicians must prescribe medications in their Treatment plans to populate this queue.</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- RIGHT PANEL: MEDICINE STOCK -->
        <div class="stock-panel">
            <div class="stock-card">
                <div class="card-header">
                    <i data-lucide="box" class="card-icon text-info"></i>
                    <h4>Medicine Stock Inventory</h4>
                </div>
                <div class="card-body">
                    <!-- Refill / Add New Medicine Form -->
                    <form asp-action="UpdateStock" asp-controller="Pharmacist" method="post" style="margin-bottom: 20px; padding: 14px; background: #f8fafc; border: 1px dashed var(--border); border-radius: var(--radius-md);">
                        <h5 style="margin-top: 0; margin-bottom: 10px; font-size: 13px; font-weight: 700; color: var(--secondary); display: flex; align-items: center; gap: 6px;">
                            <i data-lucide="plus-circle" class="icon-tiny text-primary"></i> Refill / Add Medicine
                        </h5>
                        <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
                            <input type="text" name="medicineName" placeholder="Medicine name (e.g. Paracetamol 650mg)" required style="flex: 2; min-width: 150px; padding: 8px 12px; border: 1px solid var(--border); border-radius: var(--radius-md); font-size: 13px; background-color: var(--surface); color: var(--text-main);" />
                            <input type="number" name="amount" placeholder="Qty" value="100" min="1" required style="width: 80px; padding: 8px 12px; border: 1px solid var(--border); border-radius: var(--radius-md); font-size: 13px; background-color: var(--surface); color: var(--text-main);" />
                            <button type="submit" class="btn btn-primary btn-xs" style="padding: 9px 16px; font-size: 12px; font-weight: 600;"><i data-lucide="plus" class="icon-tiny"></i> Add Stock</button>
                        </div>
                    </form>

                    <table class="table">
                        <thead>
                            <tr>
                                <th>Medicine Name</th>
                                <th class="text-right">Stock Level (Add / Remove)</th>
                                <th class="text-right" style="width: 100px;">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var kvp in stock)
                            {
                                var isLow = kvp.Value < 100;
                                <tr>
                                    <td><strong>@kvp.Key</strong></td>
                                    <td class="text-right">
                                        <div style="display: flex; align-items: center; justify-content: flex-end; gap: 8px;">
                                            <strong style="font-size: 14px; color: var(--text-main);">@kvp.Value</strong> 
                                            <span style="font-size: 11.5px; color: var(--text-muted); margin-right: 4px;">units</span>
                                            <div style="display: inline-flex; gap: 3px;">
                                                <form asp-action="UpdateStock" asp-controller="Pharmacist" method="post" style="display: inline;">
                                                    <input type="hidden" name="medicineName" value="@kvp.Key" />
                                                    <input type="hidden" name="amount" value="-10" />
                                                    <button type="submit" class="btn btn-outline btn-xs" style="padding: 2px 8px; font-weight: bold; border-color: #cbd5e1; font-size: 13px;" title="Deduct 10 units">-</button>
                                                </form>
                                                <form asp-action="UpdateStock" asp-controller="Pharmacist" method="post" style="display: inline;">
                                                    <input type="hidden" name="medicineName" value="@kvp.Key" />
                                                    <input type="hidden" name="amount" value="10" />
                                                    <button type="submit" class="btn btn-primary btn-xs" style="padding: 2px 8px; font-weight: bold; font-size: 13px;" title="Add 10 units">+</button>
                                                </form>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-right">
                                        @if (isLow)
                                        {
                                            <span class="badge badge-danger">Low Stock</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-success">In Stock</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
