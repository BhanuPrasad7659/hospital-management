@using System.Security.Claims

<header class="top-navbar">
    <!-- Navbar Left: Toggle Sidebar & Breadcrumbs -->
    <div class="navbar-left">
        <button class="sidebar-toggle-btn" id="sidebarToggle" onclick="toggleSidebar()">
            <i data-lucide="menu"></i>
        </button>
        
        <!-- Breadcrumb Navigation -->
        <nav class="breadcrumb-nav">
            <span class="breadcrumb-item">CogMedi</span>
            <span class="breadcrumb-separator">/</span>
            <span class="breadcrumb-item active">
                @{
                    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
                    var action = ViewContext.RouteData.Values["action"]?.ToString();
                    @($"{controller} / {action}")
                }
            </span>
        </nav>
    </div>
    
    <!-- Navbar Center: Global Search -->
    <div class="navbar-center">
        <div class="search-box">
            <i data-lucide="search" class="search-icon"></i>
            <input type="text" placeholder="Search patients, EHRs, lab records..." id="globalSearch" />
        </div>
    </div>
    
    <!-- Navbar Right: Alerts & User Profile -->
    <div class="navbar-right">
        <!-- Notification Dropdown Trigger -->
        <div class="nav-icon-wrapper" id="notificationWrapper">
            <button class="nav-icon-btn" onclick="toggleDropdown('notificationDropdown')">
                <i data-lucide="bell"></i>
                <span class="badge badge-warning">3</span>
            </button>
            
            <!-- Notifications Dropdown -->
            <div class="dropdown-menu notification-dropdown" id="notificationDropdown">
                <div class="dropdown-header">
                    <h4>Notifications</h4>
                    <span class="mark-read">Mark all as read</span>
                </div>
                <ul class="notification-list">
                    <li class="unread">
                        <div class="notif-icon primary"><i data-lucide="user-check"></i></div>
                        <div class="notif-content">
                            <p>New patient <strong>Rakesh Patel</strong> registered.</p>
                            <span>2 mins ago</span>
                        </div>
                    </li>
                    <li class="unread">
                        <div class="notif-icon success"><i data-lucide="clipboard-check"></i></div>
                        <div class="notif-content">
                            <p>Lab CBC Test results uploaded for <strong>Priya Patel</strong>.</p>
                            <span>15 mins ago</span>
                        </div>
                    </li>
                    <li>
                        <div class="notif-icon info"><i data-lucide="credit-card"></i></div>
                        <div class="notif-content">
                            <p>Bill of ₹3,050 settled by <strong>Amit Sharma</strong>.</p>
                            <span>1 hour ago</span>
                        </div>
                    </li>
                </ul>
                <div class="dropdown-footer">
                    <a href="#">View all notifications</a>
                </div>
            </div>
        </div>
        
        <!-- User Profile Dropdown Trigger -->
        <div class="nav-profile-wrapper" id="profileWrapper">
            <button class="nav-profile-btn" onclick="toggleDropdown('profileDropdown')">
                <div class="avatar">
                    @{
                        var fullName = User.FindFirst(ClaimTypes.GivenName)?.Value ?? "User";
                        var initials = string.Join("", fullName.Split(' ').Select(n => n[0])).ToUpper();
                        if (initials.Length > 2) initials = initials.Substring(0, 2);
                        @initials
                    }
                </div>
                <div class="profile-meta">
                    <span class="user-name">@fullName</span>
                    <span class="user-role">@User.FindFirst(ClaimTypes.Role)?.Value</span>
                </div>
                <i data-lucide="chevron-down" class="chevron-icon"></i>
            </button>
            
            <!-- Profile Dropdown -->
            <div class="dropdown-menu profile-dropdown" id="profileDropdown">
                <div class="dropdown-header">
                    <h4>@fullName</h4>
                    <span>@User.Identity?.Name</span>
                </div>
                <ul>
                    <li><a href="/settings"><i data-lucide="user"></i> My Profile</a></li>
                    <li><a href="/settings"><i data-lucide="settings"></i> Settings</a></li>
                    <li class="divider"></li>
                    <li><a href="/auth/logout" class="text-danger"><i data-lucide="log-out"></i> Sign Out</a></li>
                </ul>
            </div>
        </div>
    </div>
</header>
