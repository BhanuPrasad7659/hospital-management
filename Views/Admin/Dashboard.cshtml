@model DashboardViewModel
@{
    ViewData["Title"] = "System Administrator Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/dashboard.css" asp-append-version="true" />
}

<div class="dashboard-container">
    <!-- Welcome Header -->
    <div class="dashboard-header">
        <div class="header-text">
            <h2>Welcome back, @Model.UserDisplayName</h2>
            <p>Here is the system overview for CogMedi Hospital Management System today.</p>
        </div>
        <div class="header-date">
            <i data-lucide="calendar"></i>
            <span>@DateTime.Now.ToString("dd MMMM, yyyy")</span>
        </div>
    </div>

    <!-- Stat Widgets Grid -->
    <div class="metrics-grid">
        <div class="metric-card">
            <div class="metric-info">
                <span class="card-label">Total Patients</span>
                <h3>@Model.TotalPatients</h3>
                <span class="card-trend text-success"><i data-lucide="trending-up" class="icon-xs"></i> +12% this month</span>
            </div>
            <div class="metric-icon primary"><i data-lucide="users"></i></div>
        </div>

        <div class="metric-card">
            <div class="metric-info">
                <span class="card-label">Active Admissions</span>
                <h3>@Model.AdmittedPatients</h3>
                <span class="card-trend text-warning"><i data-lucide="activity" class="icon-xs"></i> Current Ward occupancy</span>
            </div>
            <div class="metric-icon warning"><i data-lucide="bed-double"></i></div>
        </div>

        <a href="/admin/doctors" class="metric-card" style="text-decoration: none; color: inherit; cursor: pointer;">
            <div class="metric-info">
                <span class="card-label">Total Doctors</span>
                <h3>@Model.TotalDoctors</h3>
                <span class="card-trend text-info"><i data-lucide="shield-check" class="icon-xs"></i> Active on duty</span>
            </div>
            <div class="metric-icon info"><i data-lucide="heart-pulse"></i></div>
        </a>

        <div class="metric-card">
            <div class="metric-info">
                <span class="card-label">Total Revenue</span>
                <h3>₹@Model.TotalRevenue.ToString("N0")</h3>
                <span class="card-trend text-success"><i data-lucide="trending-up" class="icon-xs"></i> Bills settled</span>
            </div>
            <div class="metric-icon success"><i data-lucide="indian-rupee"></i></div>
        </div>

        <div class="metric-card">
            <div class="metric-info">
                <span class="card-label">Lab Orders</span>
                <h3>@Model.CompletedLabOrders Completed</h3>
                <span class="card-trend text-muted">@Model.PendingLabOrders Pending</span>
            </div>
            <div class="metric-icon danger"><i data-lucide="test-tube-2"></i></div>
        </div>

        <div class="metric-card">
            <div class="metric-info">
                <span class="card-label">Active Treatments</span>
                <h3>@Model.ActiveTreatments</h3>
                <span class="card-trend text-success"><i data-lucide="check" class="icon-xs"></i> Under care</span>
            </div>
            <div class="metric-icon secondary"><i data-lucide="stethoscope"></i></div>
        </div>
    </div>

    <!-- Charts Section -->
    <div class="charts-grid">
        <!-- Monthly Revenue Chart -->
        <div class="chart-card">
            <div class="chart-header">
                <h4>Monthly Revenue Analysis</h4>
                <div class="chart-actions">
                    <span class="badge badge-primary">2026</span>
                </div>
            </div>
            <div class="chart-body">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>

        <!-- Patient Growth Chart -->
        <div class="chart-card">
            <div class="chart-header">
                <h4>Patient Registration Growth</h4>
                <div class="chart-actions">
                    <span class="badge badge-success">Live</span>
                </div>
            </div>
            <div class="chart-body">
                <canvas id="patientChart"></canvas>
            </div>
        </div>

        <!-- Department Occupancy Chart -->
        <div class="chart-card">
            <div class="chart-header">
                <h4>Department Analytics</h4>
                <div class="chart-actions">
                    <span class="badge badge-info">Occupancy</span>
                </div>
            </div>
            <div class="chart-body">
                <canvas id="deptChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Tables & Activities -->
    <div class="details-grid">
        <!-- Recent Admissions Table -->
        <div class="table-card">
            <div class="card-header">
                <h4>Recent Admissions</h4>
                <a href="/receptionist/admission" class="btn btn-primary btn-xs">Manage Admissions</a>
            </div>
            <div class="card-body">
                @if (Model.RecentAdmissions != null && Model.RecentAdmissions.Count > 0)
                {
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Patient ID</th>
                                <th>Name</th>
                                <th>Age / Gender</th>
                                <th>Status</th>
                                <th>Registered Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var patient in Model.RecentAdmissions)
                            {
                                <tr>
                                    <td><strong>@patient.PatientId</strong></td>
                                    <td>@patient.Name</td>
                                    <td>@patient.Age yrs / @patient.Gender</td>
                                    <td>
                                        <span class="badge @(patient.Status == "ADMITTED" ? "badge-warning" : patient.Status == "DISCHARGED" ? "badge-success" : "badge-info")">
                                            @patient.Status
                                        </span>
                                    </td>
                                    <td>@patient.CreatedDate.ToString("dd-MM-yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="empty-state">
                        <i data-lucide="users" class="empty-icon"></i>
                        <p>No recent patients registered.</p>
                    </div>
                }
            </div>
        </div>

        <!-- System Activity Log -->
        <div class="activity-card">
            <div class="card-header">
                <h4>System Audit Activity Log</h4>
                <span class="activity-pulse"></span>
            </div>
            <div class="card-body">
                <ul class="activity-timeline">
                    @foreach (var log in Model.RecentActivities)
                    {
                        <li>
                            <div class="activity-bullet"></div>
                            <div class="activity-content">
                                <p>@log</p>
                                <span>Just now</span>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </div>

    <!-- Staff Registry Panel (Admin Feature) -->
    <div style="margin-top: 24px;">
        <!-- Staff Registry Table -->
        <div class="table-card">
            <div class="card-header">
                <div style="display: flex; align-items: center;">
                    <i data-lucide="users" class="card-icon text-info" style="margin-right: 8px;"></i>
                    <h4>Current Staff Directory</h4>
                </div>
                @{
                    var staffList = ViewBag.StaffList as List<User> ?? new List<User>();
                }
                <span class="badge badge-primary">@staffList.Count Active Staff</span>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Full Name</th>
                                <th>Username</th>
                                <th>Assigned Role</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var staff in staffList)
                            {
                                <tr>
                                    <td><strong>@staff.FullName</strong></td>
                                    <td>@staff.Username</td>
                                    <td>
                                        <span class="badge @(staff.Role == "admin" ? "badge-danger" : staff.Role == "doctor" ? "badge-info" : staff.Role == "laboratory" ? "badge-primary" : staff.Role == "billing discharge" ? "badge-warning" : "badge-success")">
                                            @staff.Role
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // 1. Revenue Chart (Line)
            const ctxRevenue = document.getElementById('revenueChart').getContext('2d');
            new Chart(ctxRevenue, {
                type: 'line',
                data: {
                    labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
                    datasets: [{
                        label: 'Revenue (₹)',
                        data: [120000, 185000, 240000, 190000, 310000, 385000],
                        borderColor: '#0284c7',
                        backgroundColor: 'rgba(2, 132, 199, 0.1)',
                        borderWidth: 3,
                        fill: true,
                        tension: 0.4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { grid: { color: '#f1f5f9' } },
                        x: { grid: { display: false } }
                    }
                }
            });

            // 2. Patient Growth Chart (Bar)
            const ctxPatient = document.getElementById('patientChart').getContext('2d');
            new Chart(ctxPatient, {
                type: 'bar',
                data: {
                    labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
                    datasets: [{
                        label: 'New Registrations',
                        data: [150, 210, 180, 290, 320, 410],
                        backgroundColor: '#10b981',
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { grid: { color: '#f1f5f9' } },
                        x: { grid: { display: false } }
                    }
                }
            });

            // 3. Department Analytics Chart (Doughnut)
            const ctxDept = document.getElementById('deptChart').getContext('2d');
            new Chart(ctxDept, {
                type: 'doughnut',
                data: {
                    labels: ['Cardiology', 'Neurology', 'Orthopedics', 'Pediatrics', 'Radiology', 'Emergency'],
                    datasets: [{
                        data: [12, 8, 15, 24, 6, 30],
                        backgroundColor: ['#0284c7', '#3b82f6', '#10b981', '#f59e0b', '#8b5cf6', '#ef4444'],
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'right',
                            labels: { boxWidth: 12, font: { family: 'Inter' } }
                        }
                    }
                }
            });
        });
    </script>
}
